type mm-qcamerad, domain;
type mm-qcamerad_exec, exec_type, file_type;

init_daemon_domain(mm-qcamerad)

allow mm-qcamerad self:process execmem;
allow mm-qcamerad self:socket create_socket_perms;
allowxperm mm-qcamerad self:socket ioctl { 0xc300-0xc305 };
allow mm-qcamerad self:unix_dgram_socket create_socket_perms;

type_transition mm-qcamerad camera_data_file:sock_file camera_socket "cam_socket1";
type_transition mm-qcamerad camera_data_file:sock_file camera_socket "cam_socket2";

allow mm-qcamerad camera_socket:sock_file create_file_perms;
allow mm-qcamerad camera_data_file:dir create_dir_perms;
allow mm-qcamerad camera_data_file:file create_file_perms;
allow mm-qcamerad camera_data_file:sock_file create_file_perms;

allow cameraserver mm-qcamerad:unix_dgram_socket sendto;
allow mm-qcamerad cameraserver:fd use;
allow mm-qcamerad cameraserver:unix_stream_socket rw_socket_perms;
allow mm-qcamerad system_server:unix_stream_socket rw_socket_perms;
allow mm-qcamerad sensorservice_service:service_manager find;
binder_use(mm-qcamerad)
binder_call(mm-qcamerad, system_server)

allow mm-qcamerad camera_device:chr_file rw_file_perms;
allow mm-qcamerad video_device:dir r_dir_perms;
allow mm-qcamerad video_device:chr_file rw_file_perms;
allow mm-qcamerad gpu_device:chr_file rw_file_perms;
allow mm-qcamerad graphics_device:dir r_dir_perms;
allow mm-qcamerad graphics_device:chr_file rw_file_perms;
allow mm-qcamerad input_device:dir r_dir_perms;
allow mm-qcamerad input_device:chr_file r_file_perms;
allow mm-qcamerad sensors_device:chr_file rw_file_perms;
allow mm-qcamerad qdsp_device:chr_file rw_file_perms;
allow mm-qcamerad ion_device:chr_file rw_file_perms;

allow mm-qcamerad socket_device:dir rw_dir_perms;
unix_socket_connect(mm-qcamerad, sensors, sensors)

allow mm-qcamerad persist_file:dir search;
allow mm-qcamerad sensors_persist_file:dir r_dir_perms;
allow mm-qcamerad sensors_persist_file:file r_file_perms;

r_dir_file(mm-qcamerad, adsprpcd_file)
r_dir_file(mm-qcamerad, firmware_file)
r_dir_file(mm-qcamerad, system_file)
r_dir_file(mm-qcamerad, vendor_file)

set_prop(mm-qcamerad, camera_prop)
