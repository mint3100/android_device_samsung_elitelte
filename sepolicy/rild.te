binder_use(rild)
allow rild qmuxd_socket:dir create_dir_perms;
unix_socket_connect(rild, qmuxd, qmuxd)
allow rild qmuxd_socket:sock_file { create getattr read setattr unlink write };
allow rild netmgrd_socket:dir r_dir_perms;
unix_socket_connect(rild, netmgrd, netmgrd)
allow rild netmgrd_socket:sock_file { getattr read write };
binder_call(rild, per_mgr)
binder_call(per_mgr, rild)
allow rild binder_per_mgr_service:service_manager find;
allow rild self:socket ioctl;
allowxperm rild self:socket ioctl { 0xc300-0xc305 };
allow rild diag_device:chr_file rw_file_perms;
allow rild self:capability { chown dac_override dac_read_search fowner sys_module };
allow rild sysfs_sec_key:dir rw_dir_perms;
allow rild sysfs_sec_key:file rw_file_perms;
allow rild proc_net:file rw_file_perms;
set_prop(rild, net_radio_prop)

allow rild radio_data_file:dir rw_dir_perms;
allow rild radio_data_file:file create_file_perms;
allow rild radio_data_file:lnk_file read;
