# Samsung elitelte keypad matrix.
# Stock MM does not ship a device-specific keylayout; these mappings mirror
# Samsung's Generic.kl entries, translated to LineageOS 15.1 key names.

key 2     1
key 3     2
key 4     3
key 5     4
key 6     5
key 7     6
key 8     7
key 9     8
key 10    9
key 11    0
key 14    DEL
key 103   DPAD_UP
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 108   DPAD_DOWN
key 158   BACK
key 172   HOME
key 212   CAMERA
key 231   CALL
key 254   APP_SWITCH
key 353   DPAD_CENTER
key 429   CONTACTS
key 430   ENVELOPE
key 522   STAR
key 523   POUND
key 580   ASSIST
